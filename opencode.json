{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "disabled": false,
      "root": "art.isticcore",
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
      "command": ["typescript-language-server", "--stdio"]
    },
    "tailwindcss": {
      "disabled": false,
      "root": "art.isticcore",
      "extensions": [".css"],
      "command": [
        "tailwindcss-language-server",
        "--stdio"
      ]
    }
  }
}